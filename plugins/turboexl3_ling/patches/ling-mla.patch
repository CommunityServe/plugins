+/// turboexl3_ling: the MLA prompt attention as one causal flash launch (src/ling_flash.zig), ahead of the spans.
+const ling_flash = @import("../../../ling_flash.zig");
+
+/// `out` = the attention of `queries` `[B, H, S, D]` over `keys`/`values` (`[B, Hk, T, *]`, the query rows the last S
+/// of the T), in spans of `prompt_span_rows` query rows past that width (`mode` causal: each span over the keys up to
+/// its last row, causal from the bottom right as MLX aligns it).
+fn spanAttn(out: *mlx.mlx_array, queries: mlx.mlx_array, keys: mlx.mlx_array, values: mlx.mlx_array, scale: f32, seq_len: c_int, mode: [*:0]const u8, s: mlx.mlx_stream) !void {
+    if (ling_flash.takes(mode, seq_len)) if (try ling_flash.attend(out, queries, keys, values, scale, s)) return;
+    const none_mask = mlx.mlx_array_new();
+    defer _ = mlx.mlx_array_free(none_mask);
+    if (std.mem.orderZ(u8, mode, "causal") == .eq) {
+        if (try attn_spans.attend(out, queries, keys, values, scale, seq_len, prompt_span_rows, s)) {
+            ran.mark(.MLA_SPANS);
+            return;
+        }
+    }
+    if (seq_len <= prompt_span_rows) {
+        try mlx.check(mlx.mlx_fast_scaled_dot_product_attention(out, queries, keys, values, scale, mode, none_mask, .{ .ctx = null }, false, s));
+        return;
+    }
+    const qs = mlx.getShape(queries);
+    const ks = mlx.getShape(keys);
+    const vs = mlx.getShape(values);
+    const first = ks[2] - seq_len;
+    const parts = mlx.mlx_vector_array_new();
+    defer _ = mlx.mlx_vector_array_free(parts);
+    const st4 = [_]c_int{ 1, 1, 1, 1 };
+    var r0: c_int = 0;
+    while (r0 < seq_len) : (r0 += prompt_span_rows) {
+        const r1 = @min(r0 + prompt_span_rows, seq_len);
+        var q = mlx.mlx_array_new();
+        defer _ = mlx.mlx_array_free(q);
+        try mlx.check(mlx.mlx_slice(&q, queries, &[_]c_int{ 0, 0, r0, 0 }, 4, &[_]c_int{ qs[0], qs[1], r1, qs[3] }, 4, &st4, 4, s));
+        var k = mlx.mlx_array_new();
+        defer _ = mlx.mlx_array_free(k);
+        try mlx.check(mlx.mlx_slice(&k, keys, &[_]c_int{ 0, 0, 0, 0 }, 4, &[_]c_int{ ks[0], ks[1], first + r1, ks[3] }, 4, &st4, 4, s));
+        var v = mlx.mlx_array_new();
+        defer _ = mlx.mlx_array_free(v);
+        try mlx.check(mlx.mlx_slice(&v, values, &[_]c_int{ 0, 0, 0, 0 }, 4, &[_]c_int{ vs[0], vs[1], first + r1, vs[3] }, 4, &st4, 4, s));
+        var o = mlx.mlx_array_new();
+        defer _ = mlx.mlx_array_free(o);
+        try mlx.check(mlx.mlx_fast_scaled_dot_product_attention(&o, q, k, v, scale, mode, none_mask, .{ .ctx = null }, false, s));
+        _ = mlx.mlx_vector_array_append_value(parts, o);
+    }
+    try mlx.check(mlx.mlx_concatenate_axis(out, parts, 2, s));
+}
