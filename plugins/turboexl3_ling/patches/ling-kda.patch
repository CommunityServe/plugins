+/// turboexl3_ling: an exact verify's rows. The projections run over every row (turboexl3's linears are row-independent;
+/// a dense one goes row by row through `mm`); then each row's conv, gates, recurrence and gated norm take the one-row
+/// path serial decode takes, the state after every row kept for a partial accept's rollback (`spec_state_seq`
+/// [S, 1, Hv, Dv, Dk], `spec_conv_input` the window's 3 inputs then the rows', as the capture kernel leaves them);
+/// then the out projection over every row.
+fn exactRows(m: *Model, x: Array, la: *const Kda, e: *Entry, seq_len: c_int) !Array {
+    const s = m.s;
+    // b_proj in projFused's launch (projFusedB: b_fused), else its own matmul below
+    var b_fused: Array = .{ .ctx = null };
