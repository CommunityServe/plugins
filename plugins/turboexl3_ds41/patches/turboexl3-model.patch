+    // one-row run region (the served layers' full runs launch it; a first prompt compiles nothing).
+    const og: usize = c.dsv4_o_groups;
+    if (fa.mode == .on and og > 0 and try sat.headsLayerBegin(true, 1, og, H / og * D, m.act)) {
+        defer sat.headsLayerEnd();
+        sat.headsSpan(true, true, 0);
+        var carriers: [2]A = undefined;
+        for (&carriers, 0..) |*h, i| h.* = (try attnGather(&sc, m, sink, q, if (i == 0) qt else none, kw, W - 1, none, none, 1.0, .{ .periods = periods, .p0 = 0 })) orelse return error.Dsv41RingWarm;
+        try evalAll(&carriers);
