+/// D2's prompt: three routed layers' calls, layer-major. Layers 0 and 1: 60 tokens x top-6, 37 experts each (two at 30
+/// rows, fifteen at 12, twenty at 6); layer 2: 10 tokens x top-6 over 7 experts. And the routes D2 predicts, hottest
+/// first, for layer 1 (five of its eight hottest: 43, 48 at 30 rows, 11, 13, 15 at 12; two it routes below them: 33, 35,
+/// its ninth and tenth; one it never routes: 100) and layer 2 (its seven, and 101, never routed).
+const D2Prompt = struct {
+    const n = 60;
+    const n2 = 10;
+    const k = 6;
+    const pred1 = [_]u16{ 43, 48, 11, 13, 15, 33, 35, 100 };
+    const pred2 = [_]u16{ 70, 71, 72, 73, 74, 75, 76, 101 };
+    ids0: [n * k]u16 = undefined,
+    ids1: [n * k]u16 = undefined,
+    ids2: [n2 * k]u16 = undefined,
+    fn init() D2Prompt {
+        var p: D2Prompt = .{};
+        for (&p.ids0, 0..) |*e, i| e.* = @intCast((i % k) * 10 + ((i / k) * (i % k + 3)) % 10);
+        for (&p.ids1, 0..) |*e, i| e.* = @intCast((i % k) * 10 + ((i / k) * (i % k + 1) + 3) % 10);
+        for (&p.ids2, 0..) |*e, i| e.* = @intCast(70 + ((i / k) + (i % k)) % 7);
+        return p;
+    }
+};
