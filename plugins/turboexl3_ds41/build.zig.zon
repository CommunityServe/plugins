        // kernels this plugin runs are #3's (c3bb0e2): the banked decode (moeClampedBanked, Config.banked_group 4, the
        // skip id, banked_m3, banked_variant_gu / banked_variant_dn), pgemm (pg2) and the shared expert's finish (F3:
        // sharedSwiglu, shfin).
        .turboexl3 = .{
            .url = "https://github.com/davidtai/turboexl3/archive/c7ce66c12f6992eabda5db1d11934a6fe5efec33.tar.gz",
            .hash = "turboexl3-0.1.0-tZE8b-RXSAGaGiiBTBRCHN-0YwTOn8nsHXaePypJAJh_",
        },
    },
    .paths = .{ "build.zig", "build.zig.zon", "plugin.zig", "config.zig", "src", "scripts", "patches", "tests", "NOTICE", "README.md" },
}
