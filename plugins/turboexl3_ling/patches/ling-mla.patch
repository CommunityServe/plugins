+/// The MTP head's latent attention (`ling_mtp_latent.isHead`): appends the chunk's normed latent `[B, S, kv_lora]` and
+/// roped shared key `k_rot` `[B, 1, S, rope]`, then attends over every cached row into `out` `[B, H, S, v]`.
+fn latentAttn(
+    self: *const trunk.Model,
+    sl: Slots,
+    fa: *const trunk.Mla,
+    layer: u32,
+    batch: c_int,
+    seq_len: c_int,
+    attn_scale: f32,
+    q_nope: mlx.mlx_array,
+    q_rot: mlx.mlx_array,
+    latent: mlx.mlx_array,
+    k_rot: mlx.mlx_array,
+    is_prefill: bool,
+    out: *mlx.mlx_array,
+) !void {
+    const cfg = self.c;
+    const s = self.s;
+    const h_count: c_int = @intCast(cfg.num_attention_heads);
+    const nope: c_int = @intCast(cfg.mla_qk_nope_head_dim);
+    const rope_d: c_int = @intCast(cfg.mla_qk_rope_head_dim);
+    const v_dim: c_int = @intCast(cfg.mla_v_head_dim);
+    const kv_lora: c_int = @intCast(cfg.mla_kv_lora_rank);
+    const perm = [_]c_int{ 0, 2, 1, 3 };
+    const strides4 = [_]c_int{ 1, 1, 1, 1 };
+    // kv_b as a plain matrix (a quantized one has no halves to fold), held as the loader holds a dense projection: the
+    // `[kv_lora, H * (nope + v)]` view a plain matmul reads (trunk.zig `proj`), which the prompt chunk's `self.mm` reads.
+    const w = fa.kv_b.w;
+    if (fa.kv_b.exl3 or fa.kv_b.bits != 0 or w.ctx == null) return error.LingLatentCacheNeedsPlainKvB;
+    var lat4 = mlx.mlx_array_new();
+    defer _ = mlx.mlx_array_free(lat4);
+    try mlx.check(mlx.mlx_reshape(&lat4, latent, &[_]c_int{ batch, 1, seq_len, kv_lora }, 4, s));
+    var kv_view = try sl.append(0, layer, lat4, k_rot, s);
+    defer kv_view.deinit();
+    const total: c_int = mlx.getShape(kv_view.k)[2];
+    const sel_mode: [*:0]const u8 = if (is_prefill) "causal" else "";
+    if (seq_len > absorbed_max_rows) {
+        // A prompt chunk: every cached row expanded through kv_b, then the naive attention.
+        var lat_all = mlx.mlx_array_new();
+        defer _ = mlx.mlx_array_free(lat_all);
+        try mlx.check(mlx.mlx_reshape(&lat_all, kv_view.k, &[_]c_int{ batch, total, kv_lora }, 3, s));
+        const kv_flat = try self.mm(&fa.kv_b, lat_all);
+        defer _ = mlx.mlx_array_free(kv_flat);
+        var kv_heads = mlx.mlx_array_new();
+        defer _ = mlx.mlx_array_free(kv_heads);
+        try mlx.check(mlx.mlx_reshape(&kv_heads, kv_flat, &[_]c_int{ batch, total, h_count, nope + v_dim }, 4, s));
+        var kv_t = mlx.mlx_array_new();
+        defer _ = mlx.mlx_array_free(kv_t);
+        try mlx.check(mlx.mlx_transpose_axes(&kv_t, kv_heads, &perm, 4, s));
+        var k_nope = mlx.mlx_array_new();
+        defer _ = mlx.mlx_array_free(k_nope);
+        try mlx.check(mlx.mlx_slice(&k_nope, kv_t, &[_]c_int{ 0, 0, 0, 0 }, 4, &[_]c_int{ batch, h_count, total, nope }, 4, &strides4, 4, s));
+        var v_t = mlx.mlx_array_new();
+        defer _ = mlx.mlx_array_free(v_t);
+        try mlx.check(mlx.mlx_slice(&v_t, kv_t, &[_]c_int{ 0, 0, 0, nope }, 4, &[_]c_int{ batch, h_count, total, nope + v_dim }, 4, &strides4, 4, s));
+        var k_rot_b = mlx.mlx_array_new();
+        defer _ = mlx.mlx_array_free(k_rot_b);
+        try mlx.check(mlx.mlx_broadcast_to(&k_rot_b, kv_view.v, &[_]c_int{ batch, h_count, total, rope_d }, 4, s));
+        const queries = try cat2(q_nope, q_rot, s);
+        defer _ = mlx.mlx_array_free(queries);
+        const keys = try cat2(k_nope, k_rot_b, s);
+        defer _ = mlx.mlx_array_free(keys);
+        var v_contig = mlx.mlx_array_new();
+        defer _ = mlx.mlx_array_free(v_contig);
+        try mlx.check(mlx.mlx_contiguous(&v_contig, v_t, false, s));
+        try spanAttn(out, queries, keys, v_contig, attn_scale, seq_len, sel_mode, s);
+        return;
+    }
+    // turboexl3_ling: the head's decode and verify calls run in turboexl3's three launches (each row's bits its own, so
+    // an exact verify's rows take the one call too) over kv_b's stored rows `[H * (nope + v), kv_lora]`, the transpose
+    // of the loader's view, and mark MTP_HEAD_LATENT's run-path bit. A call the kernel does not take runs the composed
+    // chain below.
+    const geo: ling_mla_latent.Geometry = .{ .heads = h_count, .nope = nope, .v = v_dim, .kv_lora = kv_lora };
+    const w_rows = try ling_mla_latent.kvRows(w, geo, s);
+    defer _ = mlx.mlx_array_free(w_rows);
+    if (try ling_mla_fused.attend(out, s, q_nope, q_rot, kv_view.k, kv_view.v, w_rows, attn_scale)) {
+        ran.mark(.MTP_HEAD_LATENT);
+        return;
+    }
+    // A decode or verify call the kernel does not take: the composed latent chain (src/ling_mla_latent.zig `decode`,
+    // the ops this file had), under a name of its own, so a run-path line shows the fused launches stopped taking a
+    // call (the served shapes never reach it).
+    ran.mark(.MTP_HEAD_LATENT_COMPOSED);
+    try ling_mla_latent.decode(out, q_nope, q_rot, kv_view.k, kv_view.v, w, geo, attn_scale, s);
+}
