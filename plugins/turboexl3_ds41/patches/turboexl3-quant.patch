+            n += 1;
+            const out = self.launch(s, t, &vars, ins[0..n]) catch
+                return intoRefuse(diag, error.ScratchWavesTwin, "exl3 scratch waves: {t}: its twin's launch failed at construction", .{spec.k});
+            defer _ = mlx.mlx_array_free(out);
