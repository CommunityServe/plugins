diff -ruN -x .generated a/plugins/glm5_next/kernels/hc_hval2_header.metal b/plugins/glm5_next/kernels/hc_hval2_header.metal
--- a/plugins/glm5_next/kernels/hc_hval2_header.metal
+++ b/plugins/glm5_next/kernels/hc_hval2_header.metal
@@ -0,0 +1,12 @@
+
+// turboexl3_glm53f: TURBOEXL3_GLM53F_SMALLOP_FUSE: stream element k of `expand(y + y2, h)`: a MoE sublayer's output as
+// its two terms (the routed sum y, the shared expert y2), added in T as `mlx_add` rounds them, then `msv_hc_hval`'s
+// expand of that sum, rounded where `expand` rounds it.
+template <typename T, int HC, int D, typename Y, typename P, typename C, typename H>
+inline float msv_hc_hval2(int k, Y y, Y y2, P post, C comb, H h) {
+    const int i = k / D;
+    const int d = k - i * D;
+    float acc = 0.0f;
+    for (int j = 0; j < HC; ++j) acc = fma(comb[j * HC + i], float(h[j * D + d]), acc);
+    return float(T(fma(post[i], float(T(float(y[d]) + float(y2[d]))), acc)));
+}
