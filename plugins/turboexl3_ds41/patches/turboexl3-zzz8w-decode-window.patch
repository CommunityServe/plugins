 /// The bytes the host lets the plugin still allocate on the GPU (set by the plugin's load); null in mlx-serve itself.
 pub var host_ceiling: ?*const fn () u64 = null;
+/// turboexl3_ds41 (the `[bank-bill]` load line): `streamBudget`'s terms at `context`, read as it reads them
+/// (MLX's recommended working set, the host's ceiling (0: none), the margin, the host's and the Engram LRU's bytes, the
+/// memory in use, and each phase's working set).
+pub const BudgetTerms = struct { recommended: u64, ceiling: u64, wired_margin: u64, host: u64, store: u64, in_use: u64, ws_prompt: u64, ws_decode: u64 };
+pub fn streamBudgetTerms(config: *const cfg_mod.Config, context: u64, wired_margin: u64) BudgetTerms {
+    return .{
+        .recommended = @as(u64, mlx.maxRecommendedWorkingSet()),
+        .ceiling = if (host_ceiling) |ceiling| ceiling() else 0,
+        .wired_margin = wired_margin,
+        .host = stream_host_bytes,
+        .store = engram_store_bytes,
+        .in_use = system.getTotalMemBytes() -| system.getAvailableMemBytes(),
+        .ws_prompt = prefillAt(config, context, stream_call_rows),
+        .ws_decode = prefillAt(config, context + stream_generation, 1),
+    };
+}
