+/// `MLX_SERVE_DSV41_WOA_ROWS=check` over a layer's runs: the runs compared, those equal bit for bit, the elements that
+/// differ and the largest absolute difference.
+const WoaCheck = struct { runs: usize = 0, equal: usize = 0, differ: u64 = 0, max_abs: f32 = 0 };
+/// MLX_SERVE_DSV41_WOA_ROWS: one run's `wo_a` over its spans' grouped heads `parts` (`[og, rows_k, in]` each), their rows
+/// joined (`[og, rows, in]`) through one `attnOutA`: `[rows, og * o_lora]` in `m.act`. With `check`, also each span's own
+/// `attnOutA`, the two compared word for word into `tally`, and the spans' served. A handle the caller frees.
+fn woaRun(sc: *Scope, m: *Dsv41Model, ly: *const Layer, parts: []const A, tally: *WoaCheck) !A {
+    const joined = try attnOutA(sc, m, ly, try sc.concat(parts, 1), null);
+    if (woa.mode != .check) return sc.out(joined);
+    const spanwise_parts = try sc.a.alloc(A, parts.len);
+    defer sc.a.free(spanwise_parts);
+    for (parts, spanwise_parts) |p, *o| o.* = try attnOutA(sc, m, ly, p, null);
+    const spanwise = try sc.concat(spanwise_parts, 0);
+    // Word for word: both outputs' bits as unsigned words of their width; the largest difference in f32.
+    const words: mlx.mlx_dtype = if (mlx.mlx_array_dtype(joined) == .float32) .uint32 else .uint16;
+    const eq = try sc.op2(mlx.mlx_equal, try sc.view(joined, words), try sc.view(spanwise, words));
+    const n_eq = try sc.sum(try sc.astype(try sc.reshape(eq, &.{-1}), .int32), 0, false);
+    const max_d = try sc.max(try sc.reshape(try sc.op1(mlx.mlx_abs, try sc.sub(try sc.astype(joined, .float32), try sc.astype(spanwise, .float32))), &.{-1}), 0, false);
+    try evalAll(&.{ n_eq, max_d });
+    var same: i32 = 0;
+    try mlx.check(mlx.mlx_array_item_int32(&same, n_eq));
+    const differ: u64 = @as(u64, mlx.mlx_array_size(joined)) - @as(u64, @intCast(same));
+    var biggest: f32 = 0;
+    try mlx.check(mlx.mlx_array_item_float32(&biggest, max_d));
+    tally.runs += 1;
+    tally.equal += @intFromBool(differ == 0);
+    tally.differ += differ;
+    tally.max_abs = @max(tally.max_abs, biggest);
+    return sc.out(spanwise);
 }
