+            const normed: Array = if (j >= g) .{ .ctx = null } else if (carried[j].ctx != null) carried[j] else try m.rmsNorm(h[j], lw.input_norm);
+            if (j < g) carried[j] = .{ .ctx = null };
+            defer if (normed.ctx != null) {
+                _ = mlx.mlx_array_free(normed);
+            };
+            const attn_out = if (j >= g) grouped: {
+                const o = d_out[j];
+                d_out[j] = .{ .ctx = null };
+                break :grouped o;
+            } else switch (lw.mixer) {
+                .kda => |*la| try slots_mod.kda(m, span_sl, 0, normed, la, li, 1, S, true, false),
+                .mla => |*w| try mla.mlaAttn(m, span_sl, normed, w, li, @intCast(pos[j]), 1, S, true),
+                .dsa => return error.LingLayerIsDsa,
+            };
+            defer _ = mlx.mlx_array_free(attn_out);
+            if (keep) |k| if (lw.mixer == .kda) for (k.after, 0..) |aj, c| if (aj == j) {
+                k.conv[c][layer_idx] = takeRef(span_sl.state(0, li, .conv));
+                k.ssm[c][layer_idx] = takeRef(span_sl.state(0, li, .ssm));
+            };
+            if (try m.narrowAddNorm(h[j], attn_out, lw.post_norm)) |fused| {
+                _ = mlx.mlx_array_free(h[j]);
+                h[j] = fused.h;
+                ff[j] = fused.normed;
+            } else {
+                var h_new = mlx.mlx_array_new();
+                try mlx.check(mlx.mlx_add(&h_new, h[j], attn_out, s));
+                _ = mlx.mlx_array_free(h[j]);
+                h[j] = h_new;
+                ff[j] = try m.rmsNorm(h[j], lw.post_norm);
+            }
+        }
+        if (lw.mlp == .moe) layer_what.end();
+        // PF_MOE_TAIL: a MoE layer whose sum the tail makes (a streamed source's routed sum plus an ungated shared
+        // expert) ends each span in one launch (src/ling_pf_tail.zig): its calls keep their unjoined outputs and its
+        // spans their shared expert outputs; the layer's end frees them.
+        const pf_arm = lw.mlp == .moe and moe_block.tailServes(&lw.mlp.moe);
+        if (pf_arm) pf_tail.arm(li, n);
+        defer if (pf_arm) pf_tail.end();
+        // The MLP: a dense FFN span by span; a MoE layer's router and shared expert span by span around its routed calls.
+        switch (lw.mlp) {
+            .dense => |*dw| for (0..n) |j| {
+                mlp_out[j] = try m.denseMlp(dw, ff[j]);
+            },
+            .moe => |*mw| try moeSpans(s, mw, ff, spans, calls, mlp_out, nextMoe(m, layer_idx)),
+        }
+        layer_what.end();
+        // The residual add and the next layer's norm, span by span.
+        // PF_MOE_TAIL: the next norm's weight widened, then eps, the armed layer's tail operand.
+        const pf_we: ?Array = if (pf_arm) pf_tail.normWeights(s, next_norm, m.rms_eps) catch null else null;
+        defer if (pf_we) |x| {
+            _ = mlx.mlx_array_free(x);
+        };
+        for (0..n) |j| {
+            // PF_MOE_TAIL: the span's tail in one launch, its residual and next norm (the chain's own arrays are freed
+            // unevaluated); a span the launch refuses keeps the chain below.
+            if (pf_we) |we| if (pf_tail.launch(s, j, h[j], we)) |o| {
+                _ = mlx.mlx_array_free(h[j]);
+                h[j] = o.h;
+                carried[j] = o.normed;
+                continue;
+            };
+            if (try m.narrowAddNorm(h[j], mlp_out[j], next_norm)) |fused| {
+                _ = mlx.mlx_array_free(h[j]);
+                h[j] = fused.h;
+                carried[j] = fused.normed;
+            } else {
+                var h_next = mlx.mlx_array_new();
+                try mlx.check(mlx.mlx_add(&h_next, h[j], mlp_out[j], s));
+                _ = mlx.mlx_array_free(h[j]);
+                h[j] = h_next;
+            }
+        }
+        freeAll(ff);
+        freeAll(mlp_out);
+        try evalLayer(m, sl, li, lw.mixer == .kda, h, carried);
+    }
+    layer_what.passEnd();
+    for (0..n) |j| {
+        if (carried[j].ctx != null) {
+            out[j] = carried[j];
+            carried[j] = .{ .ctx = null };
+        } else out[j] = try m.rmsNorm(h[j], m.final_norm);
+    }
+}
+
+/// D2: an MLA layer's grouped spans `g..` through mla.zig `mlaGroup` (one CacheOps.append for their keys and values),
+/// each span's input norm made as the span loop makes it (its carried norm, else the norm of its hidden), each output
+/// into `d_out` for the span loop to take.
+fn mixGroup(m: *trunk.Model, sl: slots_mod.Slots, lw: *const trunk.Layer, li: u32, h: []const Array, carried: []Array, pos: []const u32, spans: []const u32, g: usize, d_out: []Array) !void {
+    const a = std.heap.c_allocator;
+    const n = spans.len;
+    const xs = try a.alloc(Array, n - g);
+    defer a.free(xs);
+    @memset(xs, .{ .ctx = null });
+    defer freeAll(xs);
+    const rows = try a.alloc(c_int, n - g);
+    defer a.free(rows);
+    for (xs, rows, g..) |*x, *r, j| {
+        x.* = if (carried[j].ctx != null) carried[j] else try m.rmsNorm(h[j], lw.input_norm);
+        carried[j] = .{ .ctx = null };
+        r.* = @intCast(spans[j]);
+    }
+    try mla.mlaGroup(m, sl, xs, &lw.mixer.mla, li, @intCast(pos[g]), rows, d_out[g..n]);
+}
+
+/// A MoE layer over every span's normed rows `ff`: the router span by span, the routed experts in the calls `calls`
+/// names over whole spans (`routedSum`; each call's end, an index into `spans` past its last span, in order, the last
+/// `spans.len`), then each span's shared expert and add (`mlpFinish`) on its rows of its call.
+/// `ahead` (D2, PROMPT_AHEAD): the next routed layer, whose experts are read ahead once this layer's last routed call is
+/// built (`promptAhead`); null: none (the last routed layer).
+fn moeSpans(s: mlx.mlx_stream, mw: *const moe_block.Moe.Weights, ff: []const Array, spans: []const u32, calls: []const u32, out: []Array, ahead: ?*const moe_block.Moe.Weights) !void {
+    const a = std.heap.c_allocator;
+    var g = ops.Graph.init(a, s);
+    defer g.deinit();
+    // SHARED_LAYER_WHAT: this layer's shared-expert W_hats, decoded at its first wide span, serve its other spans;
+    // dropped once its spans are done (the layer's graph holds what it reads until `evalLayer`)
+    shared_layer.begin();
+    defer shared_layer.end();
+    const n = spans.len;
+    // C4: the calls cover the spans, each one span or more, in order
+    var prev: usize = 0;
+    for (calls) |c| {
+        if (c <= prev or c > n) return error.LayerMajorCalls;
+        prev = c;
+    }
+    if (prev != n) return error.LayerMajorCalls;
+    const routes = try a.alloc(moe_block.SpanRoute, n);
+    defer a.free(routes);
+    for (0..n) |j| routes[j] = try moe_block.mlpRoute(mw, &g, ff[j]);
+    var j0: usize = 0;
+    for (calls) |c| {
+        const j1: usize = c;
+        var xs: [64]Array = undefined;
+        var is: [64]Array = undefined;
+        var ws: [64]Array = undefined;
+        if (j1 - j0 > xs.len) return error.LayerMajorTooManySpans;
+        for (j0..j1, 0..) |j, i| {
+            xs[i] = ff[j];
+            is[i] = routes[j].inds;
+            ws[i] = routes[j].scores;
+        }
+        const k = j1 - j0;
+        const x = if (k == 1) xs[0] else try g.concat(xs[0..k], 1);
+        const inds = if (k == 1) is[0] else try g.concat(is[0..k], 1);
+        const scores = if (k == 1) ws[0] else try g.concat(ws[0..k], 1);
+        // PF_MOE_TAIL: the call's spans, whose tails read its unjoined outputs (src/ling_pf_tail.zig)
+        pf_tail.beginCall(j0, j1, spans);
+        const sum = try moe_block.routedSum(mw, &g, x, inds, scores);
+        pf_tail.endCall();
+        var at: c_int = 0;
+        for (j0..j1) |j| {
+            const S: c_int = @intCast(spans[j]);
+            const part = if (k == 1) sum else try g.sliceAxis(sum, 1, at, at + S);
+            pf_tail.atSpan(j);
+            out[j] = g.escape(try moe_block.mlpFinish(mw, &g, ff[j], part));
+            at += S;
+        }
+        j0 = j1;
+    }
+    // D2: this layer's routed calls are done (each drained its groups and let its slots go); the next routed layer's
+    // reads start now, beside this layer's tail (`evalLayer`) and the next layer's mixer.
+    if (ahead) |nw| try promptAhead(&g, nw, ff);
+}
+
+/// D2 (PROMPT_AHEAD): the next routed layer `nw`'s routes predicted over every span's rows from this layer's MoE input
+/// `ff` by that layer's own router (`mlpRoute`: its logits, Ling's group limit and its top-k: C1's decode predictor at
+/// prompt width), the ids read back in one evaluation, and handed to its source's read-ahead (`Routed.read_ahead_fn`:
+/// the predicted experts hottest first into that layer's persistent rows; that layer's routing barrier lands them before
+/// its seed). Residency only: the predicted routes choose reads, never a routed expert, a slot byte or an output. A
+/// layer without a streamed source or a read-ahead entry reads nothing.
+fn promptAhead(g: *ops.Graph, nw: *const moe_block.Moe.Weights, ff: []const Array) !void {
+    const st = nw.streamed orelse return;
+    const f = st.routed.read_ahead_fn orelse return;
+    const a = std.heap.c_allocator;
+    var t = g.scope();
+    defer t.deinit();
+    const host = try a.alloc(Array, ff.len);
+    defer a.free(host);
+    // Lever 4 (PROMPT_AHEAD_BF16): the route over a bf16 copy of that layer's router weight, so its logits are one bf16
+    // GEMM on `ff` (the activation dtype) instead of the f32 table's. The routing chain after it is the stock one
+    // (sigmoid plus bias, the group limit, top-k, in f32). Only the predicted reads can change.
+    var wb = nw.*;
+    wb.router.w = try t.astype(nw.router.w, .bfloat16);
+    ran.mark(.PROMPT_AHEAD_BF16);
+    for (ff, host) |x, *h| h.* = try t.astype((try moe_block.mlpRoute(&wb, &t, x)).inds, .uint32);
+    try ops.evalMany(host);
+    var total: usize = 0;
+    for (host) |h| total += mlx.mlx_array_size(h);
+    const ids = try a.alloc(u16, total);
+    defer a.free(ids);
+    var at: usize = 0;
+    for (host) |h| {
+        const n = mlx.mlx_array_size(h);
+        const src = (mlx.mlx_array_data_uint32(h) orelse return error.NoData)[0..n];
+        for (ids[at..][0..n], src) |*d, v| d.* = @intCast(v);
+        at += n;
+    }
+    try f(st.routed.ctx, st.layer, ids).get();
+}
+
+/// D2: the first routed layer after model layer `li` (null: none).
+fn nextMoe(m: *trunk.Model, li: usize) ?*const moe_block.Moe.Weights {
+    for (m.layers[li + 1 ..]) |*l| switch (l.mlp) {
+        .moe => |*w| return w,
+        else => {},
+    };
+    return null;
+}
+
+/// A layer's outputs evaluated: every span's hidden (and carried norm), and the layer's cache (its KDA state, or its
+/// MLA K/V) so the next layer's graph does not hold this one's.
+fn evalLayer(m: *trunk.Model, sl: slots_mod.Slots, li: u32, kda: bool, h: []const Array, carried: []const Array) !void {
+    const vec = mlx.mlx_vector_array_new();
+    defer _ = mlx.mlx_vector_array_free(vec);
+    for (h) |x| _ = mlx.mlx_vector_array_append_value(vec, x);
+    for (carried) |x| if (x.ctx != null) {
+        _ = mlx.mlx_vector_array_append_value(vec, x);
+    };
+    if (kda) {
+        inline for (.{ .conv, .ssm }) |which| {
+            const st = sl.state(0, li, which);
+            if (st.ctx != null) _ = mlx.mlx_vector_array_append_value(vec, st);
+        }
+        try mlx.check(mlx.mlx_eval(vec));
+    } else {
+        var v = try sl.view(0, li, m.s);
+        defer v.deinit();
+        _ = mlx.mlx_vector_array_append_value(vec, v.k);
+        _ = mlx.mlx_vector_array_append_value(vec, v.v);
+        try mlx.check(mlx.mlx_eval(vec));
+    }
+}
