+/// gives.
+fn rope1Attn(
+    self: *const trunk.Model,
+    sl: Slots,
+    layer: u32,
+    batch: c_int,
+    seq_len: c_int,
+    attn_scale: f32,
+    q_nope: mlx.mlx_array,
+    q_rot: mlx.mlx_array,
+    kv_flat: mlx.mlx_array,
+    k_rot: mlx.mlx_array,
+    is_prefill: bool,
+    out: *mlx.mlx_array,
+) !void {
+    const cfg = self.c;
+    const s = self.s;
+    const h_count: c_int = @intCast(cfg.num_attention_heads);
+    const nope: c_int = @intCast(cfg.mla_qk_nope_head_dim);
+    const v_dim: c_int = @intCast(cfg.mla_v_head_dim);
+    var rows4 = mlx.mlx_array_new();
+    defer _ = mlx.mlx_array_free(rows4);
+    try mlx.check(mlx.mlx_reshape(&rows4, kv_flat, &[_]c_int{ batch, 1, seq_len, h_count * (nope + v_dim) }, 4, s));
+    var kv_view = try sl.append(0, layer, k_rot, rows4, s);
+    defer kv_view.deinit();
+    // turboexl3_ling: KV_SCHEME_DENSE_COPIES (src/ling_kv_scheme.zig `atView`): one branch on the view's own `bits`
+    // (mlx-serve's `KvView.bits`, 0 on a dense cache); a quantized cache's K and V here are dense dequantized copies.
+    kv_scheme.atView(kv_view.raw.bits);
+    ran.mark(.MLA_ROPE_ONCE);
+    try rope1Read(self, kv_view.k, kv_view.v, seq_len, attn_scale, q_nope, q_rot, is_prefill, out);
+}
+
+/// turboexl3_ling: the read half of `rope1Attn`, and of D2's `mlaGroup` at each span's cut view: the attention of a
+/// call's `seq_len` query rows (`q_nope`, `q_rot` `[B, H, S, *]`) over a rope-once view, `rope` the roped keys
+/// `[B, 1, T, rope]` and `rows` kv_b's rows `[B, 1, T, H (nope + v)]`, into `out` `[B, H, S, v]`. Its T rows are the
+/// keys, and the query rows the last S of them (causal from the bottom right), so the view's row count is the call's key
+/// count.
+fn rope1Read(
+    self: *const trunk.Model,
+    rope: mlx.mlx_array,
+    rows: mlx.mlx_array,
+    seq_len: c_int,
+    attn_scale: f32,
+    q_nope: mlx.mlx_array,
+    q_rot: mlx.mlx_array,
+    is_prefill: bool,
+    out: *mlx.mlx_array,
+) !void {
+    const cfg = self.c;
+    const s = self.s;
+    const h_count: c_int = @intCast(cfg.num_attention_heads);
+    const nope: c_int = @intCast(cfg.mla_qk_nope_head_dim);
+    const v_dim: c_int = @intCast(cfg.mla_v_head_dim);
+    var vw = try ling_mla_rope1.views(rows, rope, h_count, nope, v_dim, s);
+    defer vw.deinit();
+    const total: c_int = mlx.getShape(rope)[2];
+    var queries = mlx.mlx_array_new();
+    defer _ = mlx.mlx_array_free(queries);
+    {
+        const parts = [_]mlx.mlx_array{ q_nope, q_rot };
+        const vec = mlx.mlx_vector_array_new_data(&parts, 2);
+        defer _ = mlx.mlx_vector_array_free(vec);
+        try mlx.check(mlx.mlx_concatenate_axis(&queries, vec, -1, s));
+    }
+    const sel_mode: [*:0]const u8 = if (is_prefill) "causal" else "";
+    if ((ling.exact_rows and seq_len > 1) or (!is_prefill and seq_len == 1)) {
+        // a decode row or an exact verify's rows: each row its one-row MLX SDPA call's words
+        if (try verify_rows.attendRope1(out, queries, vw.nope, vw.v, vw.rope, attn_scale, seq_len, s)) {
+            ling_mla_rope1.engaged(.rows, seq_len, total);
+            return;
+        }
+    } else if (ling_flash.takes(sel_mode, seq_len)) {
+        // a prompt call: the flash launch's words over the expanded key
+        if (try ling_mla_rope1.flash(out, queries, vw, attn_scale, s)) {
+            ling_mla_rope1.engaged(.flash, seq_len, total);
+            return;
+        }
+    }
+    // a call neither takes: the expanded key built from the views (the same words), on verifyAttn or spanAttn
+    const keys = try ling_mla_rope1.expand(vw, h_count, s);
+    defer _ = mlx.mlx_array_free(keys);
+    ling_mla_rope1.engaged(.expand, seq_len, total);
+    if (ling.exact_rows and seq_len > 1)
+        try verifyAttn(out, queries, keys, vw.v, attn_scale, seq_len, s)
+    else
+        try spanAttn(out, queries, keys, vw.v, attn_scale, seq_len, sel_mode, s);
+}
+
+// ── turboexl3_ling D2: one KV append for an MLA layer's prompt spans past 24,576 ──
+
+/// D2: one span's projections for `mlaGroup`, by `mlaAttn`'s ops at the span's own rows and position (its lines from the
+/// query to kv_b, copied, so `mlaAttn` itself is unchanged; the D2 byte test, src/ling_d2_test.zig, holds the two to the
+/// same words): the query's nope and roped halves `[B, H, S, *]`, kv_b's rows `[B, S, H (nope + v)]` and the roped
+/// shared key `[B, 1, S, rope]`.
+const SpanQkv = struct {
+    q_nope: mlx.mlx_array,
+    q_rot: mlx.mlx_array,
+    kv_flat: mlx.mlx_array,
+    k_rot: mlx.mlx_array,
+
+    fn deinit(q: *SpanQkv) void {
+        inline for (.{ q.q_nope, q.q_rot, q.kv_flat, q.k_rot }) |x| if (x.ctx != null) {
+            _ = mlx.mlx_array_free(x);
+        };
+    }
+};
+
+fn spanQkv(self: *const trunk.Model, x: mlx.mlx_array, fa: *const trunk.Mla, offset: c_int, batch: c_int, seq_len: c_int) !SpanQkv {
+    const cfg = self.c;
+    const h_count: c_int = @intCast(cfg.num_attention_heads);
+    const nope: c_int = @intCast(cfg.mla_qk_nope_head_dim);
+    const rope_d: c_int = @intCast(cfg.mla_qk_rope_head_dim);
+    const qk_dim: c_int = nope + rope_d;
+    const kv_lora: c_int = @intCast(cfg.mla_kv_lora_rank);
+    const perm = [_]c_int{ 0, 2, 1, 3 };
+    const strides3 = [_]c_int{ 1, 1, 1 };
+    const strides4 = [_]c_int{ 1, 1, 1, 1 };
+    var r: SpanQkv = .{ .q_nope = mlx.mlx_array_new(), .q_rot = mlx.mlx_array_new(), .kv_flat = .{ .ctx = null }, .k_rot = mlx.mlx_array_new() };
+    errdefer r.deinit();
+    const q_flat = if (fa.q.w.ctx != null)
+        try self.mm(&fa.q, x)
+    else blk: {
+        const q_a = try self.mm(&fa.q_a, x);
+        defer _ = mlx.mlx_array_free(q_a);
+        const q_a_n = try self.rmsNorm(q_a, fa.q_a_norm);
+        defer _ = mlx.mlx_array_free(q_a_n);
+        break :blk try self.mm(&fa.q_b, q_a_n);
+    };
+    defer _ = mlx.mlx_array_free(q_flat);
+    var q_heads = mlx.mlx_array_new();
+    defer _ = mlx.mlx_array_free(q_heads);
+    try mlx.check(mlx.mlx_reshape(&q_heads, q_flat, &[_]c_int{ batch, seq_len, h_count, qk_dim }, 4, self.s));
+    var q_t = mlx.mlx_array_new();
+    defer _ = mlx.mlx_array_free(q_t);
+    try mlx.check(mlx.mlx_transpose_axes(&q_t, q_heads, &perm, 4, self.s));
+    try mlx.check(mlx.mlx_slice(&r.q_nope, q_t, &[_]c_int{ 0, 0, 0, 0 }, 4, &[_]c_int{ batch, h_count, seq_len, nope }, 4, &strides4, 4, self.s));
+    var q_rot_raw = mlx.mlx_array_new();
+    defer _ = mlx.mlx_array_free(q_rot_raw);
+    try mlx.check(mlx.mlx_slice(&q_rot_raw, q_t, &[_]c_int{ 0, 0, 0, nope }, 4, &[_]c_int{ batch, h_count, seq_len, qk_dim }, 4, &strides4, 4, self.s));
+    const kv_a = try self.mm(&fa.kv_a, x);
+    defer _ = mlx.mlx_array_free(kv_a);
+    var latent_raw = mlx.mlx_array_new();
+    defer _ = mlx.mlx_array_free(latent_raw);
+    try mlx.check(mlx.mlx_slice(&latent_raw, kv_a, &[_]c_int{ 0, 0, 0 }, 3, &[_]c_int{ batch, seq_len, kv_lora }, 3, &strides3, 3, self.s));
+    var k_pe_flat = mlx.mlx_array_new();
+    defer _ = mlx.mlx_array_free(k_pe_flat);
+    try mlx.check(mlx.mlx_slice(&k_pe_flat, kv_a, &[_]c_int{ 0, 0, kv_lora }, 3, &[_]c_int{ batch, seq_len, kv_lora + rope_d }, 3, &strides3, 3, self.s));
+    const latent = try self.rmsNorm(latent_raw, fa.kv_a_norm);
+    defer _ = mlx.mlx_array_free(latent);
+    var k_pe_t = mlx.mlx_array_new();
+    defer _ = mlx.mlx_array_free(k_pe_t);
+    {
+        var k_pe_h = mlx.mlx_array_new();
+        defer _ = mlx.mlx_array_free(k_pe_h);
+        try mlx.check(mlx.mlx_reshape(&k_pe_h, k_pe_flat, &[_]c_int{ batch, seq_len, 1, rope_d }, 4, self.s));
+        try mlx.check(mlx.mlx_transpose_axes(&k_pe_t, k_pe_h, &perm, 4, self.s));
+    }
+    const traditional = cfg.rope_interleaved_pairs;
+    try mlx.check(mlx.mlx_fast_rope(&r.q_rot, q_rot_raw, rope_d, traditional, mlx.mlx_optional_float.some(cfg.rope_theta), 1.0, offset, .{ .ctx = null }, self.s));
+    try mlx.check(mlx.mlx_fast_rope(&r.k_rot, k_pe_t, rope_d, traditional, mlx.mlx_optional_float.some(cfg.rope_theta), 1.0, offset, .{ .ctx = null }, self.s));
+    r.kv_flat = try self.mm(&fa.kv_b, latent);
+    return r;
+}
+
+/// D2: one span's output for `mlaGroup` from its attention `attn_out` `[B, H, S, v]`, by `mlaAttn`'s ops after the
+/// attention (copied): the transpose, the head-wise gate of its input `x` and o_proj.
+fn spanOut(self: *const trunk.Model, x: mlx.mlx_array, fa: *const trunk.Mla, attn_out: mlx.mlx_array, batch: c_int, seq_len: c_int) !mlx.mlx_array {
+    const cfg = self.c;
+    const h_count: c_int = @intCast(cfg.num_attention_heads);
+    const v_dim: c_int = @intCast(cfg.mla_v_head_dim);
+    const perm = [_]c_int{ 0, 2, 1, 3 };
+    var attn_t = mlx.mlx_array_new();
+    defer _ = mlx.mlx_array_free(attn_t);
+    try mlx.check(mlx.mlx_transpose_axes(&attn_t, attn_out, &perm, 4, self.s));
+    var gated: mlx.mlx_array = .{ .ctx = null };
+    defer if (gated.ctx != null) {
+        _ = mlx.mlx_array_free(gated);
+    };
+    if (cfg.mla_head_gate and fa.g.w.ctx != null) {
+        const gate_logits = try self.mm(&fa.g, x);
+        defer _ = mlx.mlx_array_free(gate_logits);
+        var g_f32 = mlx.mlx_array_new();
+        defer _ = mlx.mlx_array_free(g_f32);
+        try mlx.check(mlx.mlx_astype(&g_f32, gate_logits, .float32, self.s));
+        var g_sig = mlx.mlx_array_new();
+        defer _ = mlx.mlx_array_free(g_sig);
+        try mlx.check(mlx.mlx_sigmoid(&g_sig, g_f32, self.s));
+        var g_cast = mlx.mlx_array_new();
+        defer _ = mlx.mlx_array_free(g_cast);
+        try mlx.check(mlx.mlx_astype(&g_cast, g_sig, mlx.mlx_array_dtype(attn_t), self.s));
+        var g_4d = mlx.mlx_array_new();
+        defer _ = mlx.mlx_array_free(g_4d);
+        try mlx.check(mlx.mlx_reshape(&g_4d, g_cast, &[_]c_int{ batch, seq_len, h_count, 1 }, 4, self.s));
+        gated = mlx.mlx_array_new();
+        try mlx.check(mlx.mlx_multiply(&gated, attn_t, g_4d, self.s));
+    }
+    var attn_flat = mlx.mlx_array_new();
+    defer _ = mlx.mlx_array_free(attn_flat);
+    try mlx.check(mlx.mlx_reshape(&attn_flat, if (gated.ctx != null) gated else attn_t, &[_]c_int{ batch, seq_len, h_count * v_dim }, 3, self.s));
+    return self.mm(&fa.o, attn_flat);
+}
+
+/// D2: `parts` joined on the row axis (2), in order: each part's words copied unchanged
+fn joinRows(parts: []const mlx.mlx_array, s: mlx.mlx_stream) !mlx.mlx_array {
+    var r = mlx.mlx_array_new();
+    errdefer _ = mlx.mlx_array_free(r);
+    const vec = mlx.mlx_vector_array_new_data(parts.ptr, parts.len);
+    defer _ = mlx.mlx_vector_array_free(vec);
+    try mlx.check(mlx.mlx_concatenate_axis(&r, vec, 2, s));
+    return r;
+}
+
+/// D2's run-path mark, at each call whose spans share an append, and its engaged line, once a process.
+var d2_said = false;
+
+fn d2Engaged(n_spans: usize, first: c_int, end: c_int) void {
+    ran.mark(.D2);
+    if (d2_said) return;
+    d2_said = true;
+    std.log.info("[turboexl3_ling] D2 engaged: an MLA layer's {d} prompt spans, positions {d} to {d}, append their keys and values in one call, so mlx-serve grows the KV once for them, not once a span; each span attends over its rows up to its own end", .{ n_spans, first, end });
+}
+
+/// turboexl3_ling D2 (one KV append for an MLA layer's prompt spans past 24,576; the copied table_forward.zig
+/// `hiddenSpans` calls it at a trunk MLA layer's spans from src/ling_rq.zig `groupStart` on): the spans `xs` (each
+/// `[1, rows[i], hidden]`, in order, the first at position `pos0`) through this layer's mixer, each span's output in
+/// `out[i]` (the caller frees them) with the words `mlaAttn` gives that span after the spans before it.
+/// - Each span's projections are `mlaAttn`'s at its own rows and position (`spanQkv`): a projection over more rows could
+///   tile differently.
+/// - Their roped keys and kv_b rows, joined in the spans' order (`joinRows`), reach the cache in one CacheOps.append. So
+///   the cache holds the words the appends a span wrote, and mlx-serve grows the KV at most once for the spans.
+/// - Each span attends over the view cut at its own last row (`rope1Read`: the view's rows are the call's keys, the
+///   span's query rows the last of them), then `spanOut`.
+/// Two spans or more mark D2 on the run-path line (`d2Engaged`).
+pub fn mlaGroup(self: *const trunk.Model, sl: Slots, xs: []const mlx.mlx_array, fa: *const trunk.Mla, layer: u32, pos0: c_int, rows: []const c_int, out: []mlx.mlx_array) !void {
+    if (xs.len == 0 or xs.len != rows.len or out.len != rows.len) return error.LingD2Group;
+    if (ling_mtp_latent.isHead(fa)) return error.LingD2HeadLayer;
+    const cfg = self.c;
+    const s = self.s;
+    const h_count: c_int = @intCast(cfg.num_attention_heads);
+    const nope: c_int = @intCast(cfg.mla_qk_nope_head_dim);
+    const v_dim: c_int = @intCast(cfg.mla_v_head_dim);
+    const width: c_int = h_count * (nope + v_dim);
+    const attn_scale: f32 = 1.0 / @sqrt(@as(f32, @floatFromInt(cfg.query_pre_attn_scalar)));
+    const st4 = [_]c_int{ 1, 1, 1, 1 };
+    const a = std.heap.c_allocator;
+    const n = rows.len;
+    // each span's projections, at its own rows and position
+    const qkv = try a.alloc(SpanQkv, n);
+    defer a.free(qkv);
+    var made: usize = 0;
+    defer for (qkv[0..made]) |*q| q.deinit();
+    var at: c_int = pos0;
+    for (xs, rows) |x, r| {
+        qkv[made] = try spanQkv(self, x, fa, at, 1, r);
+        made += 1;
+        at += r;
+    }
+    // the spans' roped keys `[1, 1, R, rope]` and kv_b rows `[1, 1, R, H (nope + v)]`, joined in order, in one append
+    const ks = try a.alloc(mlx.mlx_array, n);
+    defer a.free(ks);
+    const vs = try a.alloc(mlx.mlx_array, n);
+    defer a.free(vs);
+    for (vs) |*v| v.* = mlx.mlx_array_new();
+    defer for (vs) |v| {
+        _ = mlx.mlx_array_free(v);
+    };
+    for (qkv, rows, ks, vs) |q, r, *k, *v| {
+        k.* = q.k_rot;
+        try mlx.check(mlx.mlx_reshape(v, q.kv_flat, &[_]c_int{ 1, 1, r, width }, 4, s));
+    }
+    const k_all = try joinRows(ks, s);
+    defer _ = mlx.mlx_array_free(k_all);
+    const v_all = try joinRows(vs, s);
+    defer _ = mlx.mlx_array_free(v_all);
+    var kv_view = try sl.append(0, layer, k_all, v_all, s);
+    defer kv_view.deinit();
+    // KV_SCHEME_DENSE_COPIES and MLA_ROPE_ONCE as `rope1Attn` has them at its append
+    kv_scheme.atView(kv_view.raw.bits);
+    ran.mark(.MLA_ROPE_ONCE);
+    if (n > 1) d2Engaged(n, pos0, at);
+    // each span over the view cut at its own last row: the view holds rows [0, at) (a full cache's every row), so a
+    // span's end is its row count there; a view of any other rows is refused by name, never cut
+    const ksh = mlx.getShape(kv_view.k);
+    const vsh = mlx.getShape(kv_view.v);
+    if (ksh.len != 4 or vsh.len != 4 or ksh[2] != at or vsh[2] != at) return error.LingD2ViewRows;
+    var end: c_int = pos0;
+    for (qkv, rows, xs, out) |q, r, x, *o| {
+        end += r;
+        var kc = mlx.mlx_array_new();
+        defer _ = mlx.mlx_array_free(kc);
+        try mlx.check(mlx.mlx_slice(&kc, kv_view.k, &[_]c_int{ 0, 0, 0, 0 }, 4, &[_]c_int{ ksh[0], ksh[1], end, ksh[3] }, 4, &st4, 4, s));
+        var vc = mlx.mlx_array_new();
+        defer _ = mlx.mlx_array_free(vc);
+        try mlx.check(mlx.mlx_slice(&vc, kv_view.v, &[_]c_int{ 0, 0, 0, 0 }, 4, &[_]c_int{ vsh[0], vsh[1], end, vsh[3] }, 4, &st4, 4, s));
+        var attn = mlx.mlx_array_new();
+        defer _ = mlx.mlx_array_free(attn);
+        try rope1Read(self, kc, vc, r, attn_scale, q.q_nope, q.q_rot, true, &attn);
+        o.* = try spanOut(self, x, fa, attn, 1, r);
+    }
+}
