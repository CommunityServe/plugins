+/// turboexl3_ds41 (MLX_SERVE_DSV41_BILL_CAL's `[bank-bill]` readings): the host's speculative and purgeable pages, bytes
+/// (zeros off Darwin or on a failed query): the part of "the total less the available" that is neither wired, anonymous
+/// nor compressed (speculative) and the anonymous part the OS drops first (purgeable).
+pub fn speculativePurgeableBytes() struct { speculative: u64, purgeable: u64 } {
+    if (comptime !builtin.os.tag.isDarwin()) return .{ .speculative = 0, .purgeable = 0 };
+    var page: usize = 0;
+    if (host_page_size(mach_host_self(), &page) != 0) return .{ .speculative = 0, .purgeable = 0 };
+    var vm = std.mem.zeroes(VmStats64);
+    var count: u32 = @sizeOf(VmStats64) / @sizeOf(i32);
+    if (host_statistics64(mach_host_self(), 4, @ptrCast(&vm), &count) != 0) return .{ .speculative = 0, .purgeable = 0 };
+    return .{ .speculative = @as(u64, vm.speculative_count) * @as(u64, page), .purgeable = @as(u64, vm.purgeable_count) * @as(u64, page) };
+}
