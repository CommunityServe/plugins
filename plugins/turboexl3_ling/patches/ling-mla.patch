+/// `a` and `b` joined on the last axis.
+fn cat2(a: mlx.mlx_array, b: mlx.mlx_array, s: mlx.mlx_stream) !mlx.mlx_array {
+    var r = mlx.mlx_array_new();
+    errdefer _ = mlx.mlx_array_free(r);
+    const parts = [_]mlx.mlx_array{ a, b };
+    const vec = mlx.mlx_vector_array_new_data(&parts, 2);
+    defer _ = mlx.mlx_vector_array_free(vec);
+    try mlx.check(mlx.mlx_concatenate_axis(&r, vec, -1, s));
+    return r;
+}
