+/// The prompt timeline's probe (`MLX_SERVE_DSV41_PROMPT_IO`) at encoder layer `li`, one of `pio.probe_layers`, of a
+/// replaying chunk: every CED decoder layer's router over the tail rows' stream as it enters `li` (collapsed with its
+/// mix and normed for that layer's FFN, as the read-ahead predicts a layer's own routes), each tail row's top-k kept.
+fn probeDecoder(sc: *Scope, m: *const Dsv41Model, sp: *const Spans, li: usize, x: A, pre: A) !void {
+    const slot = for (pio.probe_layers, 0..) |pl, s| {
+        if (pl == li) break s;
+    } else return;
+    const tl = pio.tail;
+    const L = sp.L;
+    if (tl == 0 or tl > L or pio.split == 0 or li >= pio.split or m.n_layers > pio.max_layers) return;
+    const col = try hcCollapse(sc, try sc.slice(x, 0, L - tl, L), try sc.slice(pre, 0, L - tl, L));
+    const img = try sp.imgSlice(sc, L - tl, L);
+    var idxs: [pio.max_layers]A = undefined;
+    const n_dec = m.n_layers - pio.split;
+    for (pio.split..m.n_layers, 0..) |d, i| {
+        const ly = &m.layers[d];
+        idxs[i] = (try route(sc, m, ly, try sc.rms(col, ly.ffn_norm, m.cfg.rms_norm_eps), img)).idx;
+    }
+    try evalAll(idxs[0..n_dec]);
+    for (pio.split..m.n_layers, 0..) |d, i| {
