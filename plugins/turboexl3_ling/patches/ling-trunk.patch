+/// turboexl3_ling: Ling's NextN layer from `src` (the same shards the trunk read), its tensors kept by the model; null
+/// when the pack has none. Its routed experts are not read here (the plugin stacks them resident and binds them).
+pub fn lingHead(m: *Model, src: *const quant_abi.Source) !?LingHead {
+    const c = m.c;
+    const prefix = probePrefix(src, c.weight_prefix, "word_embeddings.weight");
+    var l: Loader = .{ .src = src, .c = c, .s = m.s, .prefix = prefix, .owned = &m.owned, .exl3 = null };
+    const idx: u32 = c.num_hidden_layers;
+    var bb: [96]u8 = undefined;
+    const base = try std.fmt.bufPrint(&bb, "{s}.layers.{d}", .{ prefix, idx });
+    var nb: [256]u8 = undefined;
+    if (!l.has(try std.fmt.bufPrint(&nb, "{s}.enorm.weight", .{base}))) return null;
+    var h: LingHead = .{
+        .enorm = try l.tensor(try std.fmt.bufPrint(&nb, "{s}.enorm.weight", .{base})),
+        .hnorm = try l.tensor(try std.fmt.bufPrint(&nb, "{s}.hnorm.weight", .{base})),
+        .final_norm = try l.tensor(try std.fmt.bufPrint(&nb, "{s}.final_layernorm.weight", .{base})),
+        .input_norm = try l.tensor(try std.fmt.bufPrint(&nb, "{s}.input_layernorm.weight", .{base})),
+        .post_norm = try l.tensor(try std.fmt.bufPrint(&nb, "{s}.post_attention_layernorm.weight", .{base})),
+        .eh_proj = try l.proj(try std.fmt.bufPrint(&nb, "{s}.eh_proj", .{base}), 2 * c.hidden_size),
+        .mla = try l.mla(idx),
+        .moe = try l.routed(base, true),
+    };
+    errdefer compiled.free(&h.moe.route_fn);
+    try evalTrunk(m);
+    return h;
