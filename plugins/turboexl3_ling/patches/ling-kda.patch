+    defer free(qkv);
+    const z = if (qaz) |t| t[2] else try m.mm(&la.z, x);
+    defer free(z);
+    const a = if (qaz) |t| t[1] else try m.mm(&la.a, x);
+    defer free(a);
+    const b = if (b_fused.ctx != null) b_fused else try m.mm(&la.b, x);
+    defer free(b);
+    const conv_before = ref(e.conv_state);
+    defer free(conv_before);
+    var ys: [exact_max_rows]Array = undefined;
+    var states: [exact_max_rows]Array = undefined;
+    var n: usize = 0;
+    defer for (ys[0..n], states[0..n]) |y, st| {
+        free(y);
+        free(st);
+    };
+    while (n < @as(usize, @intCast(seq_len))) {
+        const r: c_int = @intCast(n);
+        const p: Pre = .{ .qkv = try rowOf(qkv, r, s), .z = try rowOf(z, r, s), .a = try rowOf(a, r, s), .b = try rowOf(b, r, s) };
+        defer inline for (.{ p.qkv, p.z, p.a, p.b }) |t| free(t);
+        const y = try forwardWith(m, x, la, e, 1, 1, false, false, p, true);
+        ys[n] = y;
+        states[n] = ref(e.ssm_state);
+        n += 1;
+    }
+    {
+        const vec = mlx.mlx_vector_array_new_data(&states, n);
+        defer _ = mlx.mlx_vector_array_free(vec);
+        free(e.spec_state_seq);
+        e.spec_state_seq = mlx.mlx_array_new();
+        try mlx.check(mlx.mlx_stack_axis(&e.spec_state_seq, vec, 0, s));
+    }
+    {
+        const parts = [_]Array{ conv_before, qkv };
+        const vec = mlx.mlx_vector_array_new_data(&parts, 2);
+        defer _ = mlx.mlx_vector_array_free(vec);
+        free(e.spec_conv_input);
+        e.spec_conv_input = mlx.mlx_array_new();
+        try mlx.check(mlx.mlx_concatenate_axis(&e.spec_conv_input, vec, 1, s));
+    }
+    var y_all = mlx.mlx_array_new();
+    defer _ = mlx.mlx_array_free(y_all);
+    {
+        const vec = mlx.mlx_vector_array_new_data(&ys, n);
+        defer _ = mlx.mlx_vector_array_free(vec);
+        try mlx.check(mlx.mlx_concatenate_axis(&y_all, vec, 1, s));
+    }
+    return m.mm(&la.out, y_all);
+}
