+/// turboexl3_ds41 (MLX_SERVE_DSV41_L39_LAST, the plugin's src/l39_last.zig): `moe` for a replaying chunk's last decoder
+/// layer, whose output rows nothing but the logits read (the last row): the router and the shared expert over every row
+/// as `moe` runs them, the joinless routed call over the last row only, forced through the wide lane (`l39.force`: the
+/// same waves and combine as a wide call's), its row put back as the last of `moe`'s output (the other rows zero).
+/// `check`: `moe`'s own 128-row call first (the stock residency) and served, its last row compared with the one-row call's
+/// word for word. `moe` itself where its joinless wide call would not run.
+fn moeLast(sc: *Scope, m: *const Dsv41Model, li: usize, x: A, img: A) !A {
+    const ly = &m.layers[li];
+    const src = m.streamed orelse return moe(sc, m, li, x, img);
+    const f = src.source_shared orelse return moe(sc, m, li, x, img);
+    const n = dim(x, 0);
+    if (li >= m.n_layers or src.math != .source or jless.mode == .off or n < 2 or n * ly.top_k <= src.decode_ids) return moe(sc, m, li, x, img);
+    const r = try route(sc, m, ly, x, img);
+    try prof.mark(.router, &.{ r.idx, r.wts });
+    const sy = try shared(sc, m, ly, x);
+    try prof.mark(.shared, &.{sy});
+    const sy32 = try sc.astype(sy, .float32);
+    const last = try sc.ints(&.{@intCast(n - 1)}, &.{1});
+    var full = none;
+    if (l39.mode == .check) {
+        full = try sc.keep(try f(src.ctx, @intCast(li), x, r.idx, r.wts, sy32).get());
+        try prof.mark(.routed, &.{full});
+    }
+    const one = blk: {
+        l39.force = true;
+        defer l39.force = false;
+        break :blk try sc.keep(try f(src.ctx, @intCast(li), try sc.take(x, last, 0), try sc.take(r.idx, last, 0), try sc.take(r.wts, last, 0), try sc.take(sy32, last, 0)).get());
+    };
+    l39.calls += 1;
+    try prof.mark(.routed, &.{one});
+    if (full.ctx != null) {
+        const a = try sc.astype(try sc.take(full, last, 0), .float32);
+        const b = try sc.astype(one, .float32);
+        try evalAll(&.{ a, b });
+        const hidden = dim(b, 1);
+        const pa = mlx.mlx_array_data_float32(a) orelse return error.NoData;
+        const pb = mlx.mlx_array_data_float32(b) orelse return error.NoData;
+        l39.noteCheck(hidden, l39.differWords(pa[0..hidden], pb[0..hidden]));
+        return sc.astype(full, m.act);
+    }
+    const rest = try sc.zeros(&.{ ci(n - 1), ci(dim(one, 1)) }, mlx.mlx_array_dtype(one));
+    return sc.astype(try sc.concat(&.{ rest, one }, 0), m.act);
+}
