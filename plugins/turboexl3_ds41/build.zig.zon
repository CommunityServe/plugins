    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        .mlx_serve_kit = .{ .path = "../../.kit/kit" },
        // turboexl3 (davidtai/turboexl3): the EXL3 kernels and its plugin-kit launcher, at c7ce66c on turboexl3 main
