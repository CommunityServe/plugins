+/// turboexl3_ds41 (MLX_SERVE_DSV41_SHFIN=check): the stretches holding the shared expert run their body eagerly on `in`.
+fn shfinRecheck(comptime kind: Region, r: *const LayerRegions, li: usize, in: mlx.mlx_vector_array) !void {
+    switch (kind) {
+        .ffn, .ffn_post, .ffn_shared => {},
+        else => return,
+    }
+    var res: mlx.mlx_vector_array = .{ .ctx = null };
+    defer if (res.ctx != null) {
